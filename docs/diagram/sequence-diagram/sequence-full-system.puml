controller -> model ++: User.findOneAndUpdate(validResetTokenFilter, passwordUpdates, options)
model -> db ++: Save password hash; consume reset token;\nrevoke existing sessions
db --> model --: user or null
model --> controller --: user or null
    controller -> controller: Prepare success (log in again) or invalid-token error
else Invalid password, token format, or confirmation
    controller -> controller: Prepare validation error
end
controller --> client --: response (success or error)
