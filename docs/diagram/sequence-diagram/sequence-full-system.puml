newpage Request Password Reset (POST)
client -> server ++: req.post('/api/v1/auth/forgot-password')
server -> router ++: app.use('/api/v1/auth', auth)
router -> controller ++: forgotPassword()
controller -> model ++: User.findOne({email})
model -> db ++: Find account by email
db --> model --: user or null
model --> controller --: user or null
opt Account exists and resend cooldown permits request
controller -> model ++: User.findOneAndUpdate(cooldownFilter, otpUpdates, options)
model -> db ++: Save OTP hash and expiry; invalidate old reset token
db --> model --: updated user or cooldown rejection
model --> controller --: updated user or cooldown rejection
    opt OTP request recorded
        controller ->> email: sendEmail({to: user.email, ...}) with OTP
    end
end
controller -> controller: Return generic response without revealing account existence
controller --> client --: response (success or error)
deactivate router
deactivate server

newpage Verify Reset OTP (POST)
client -> server ++: req.post('/api/v1/auth/verify-otp')
server -> router ++: app.use('/api/v1/auth', auth)
router -> controller ++: verifyResetOtp()
controller -> model ++: User.findOneAndUpdate(validOtpFilter, resetTokenUpdates, options)
model -> db ++: Consume matching unexpired OTP within attempt limit;\nsave single-use reset-token hash
db --> model --: user or null
model --> controller --: user or null
alt OTP accepted
    controller -> controller: Prepare resetToken response
else Invalid, expired, or exhausted OTP
controller -> model ++: User.findOneAndUpdate(incorrectOtpFilter, {$inc: {resetOtpAttempts: 1}}, options)
model -> db ++: Count incorrect guess for an active OTP
db --> model --: attempt update result
model --> controller --: attempt update result
    controller -> controller: Prepare invalid-or-expired OTP error
end
controller --> client --: response (success or error)
deactivate router
deactivate server

