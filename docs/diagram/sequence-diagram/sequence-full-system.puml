@startuml
header Massage Reservation Sequence Diagram
footer Page %page% of %lastpage%
skinparam maxMessageSize 320
title "Full System"

participant "Client" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:routes" as router
participant "<<middleware>>\n:auth" as auth
participant "<<controllers>>\n:controllers" as controller
participant "<<model>>\n:Mongoose models" as model
database "<<MongoDB>>\n:collections" as db
participant "<<external service>>\n:Email Provider" as email

note over router, db
    Grouped lifelines represent the route, controller, model, and collection
    used on each page. Calls name the actual functions and models.
    Model queries omit populate/options details where not central to the use case.
end note

== Register (POST) ==
client -> server ++: req.post('/api/v1/auth/register')
server -> router ++: app.use('/api/v1/auth', auth)
router -> controller ++: register()
controller -> model ++: User.create({name, tel, email, password, role})
model -> model: UserSchema validation; pre-save password hashing
model -> db ++: Insert user with password hash
db --> model --: user or validation / duplicate-email error
model --> controller --: user or validation / duplicate-email error
alt User created
    controller -> model ++: user.getSignedJwtToken()
    model --> controller --: token
    ref over controller, model, db, email
        If user.role is user: sendWelcomeEmail(user) runs in background;
        create unique Coupon and send welcome email.
        Email failure does not fail registration.
    end ref
    controller -> controller: sendTokenResponse(user, 200, res)
else Invalid details or duplicate email
    controller -> controller: Prepare registration error (400)
end
controller --> client --: response (success or error)
deactivate router
deactivate server

newpage Log In (POST)
client -> server ++: req.post('/api/v1/auth/login')
server -> router ++: app.use('/api/v1/auth', auth)
router -> controller ++: login()
note over client
    Registered users and admins use the same login endpoint.
end note
opt Email and password are provided
controller -> model ++: User.findOne({email}).select('+password')
model -> db ++: Find user by email
db --> model --: user or null
model --> controller --: user or null
    opt User exists
        controller -> model ++: user.matchPassword(password)
        model --> controller --: isMatch
    end
end
alt Credentials are valid
    controller -> model ++: user.getSignedJwtToken()
    model --> controller --: token
    controller -> controller: sendTokenResponse(user, 200, res)
else Missing or invalid credentials
    controller -> controller: Prepare login error (400 / 401)
end
controller --> client --: response (success or error)
deactivate router
deactivate server

newpage Log Out (GET)
client -> server ++: req.get('/api/v1/auth/logout')
server -> router ++: app.use('/api/v1/auth', auth)
router -> auth ++: protect(req, res, next)
auth -> auth: Authenticate Bearer token and load req.user
alt Authentication succeeds
    auth --> router: next()
else Missing, invalid, expired, or revoked token
    auth --> client: 401 Unauthorized
end
deactivate auth
opt Authentication succeeds
router -> controller ++: logout()
controller -> model ++: User.updateOne({_id: req.user.id}, {$inc: {tokenVersion: 1}})
model -> db ++: Revoke existing sessions on all devices
db --> model --: update result
model --> controller --: update result
alt User session revocation succeeds
    controller -> controller: Clear token cookie; prepare success (200)
else User missing or database failure
    controller -> controller: Prepare logout error
end
controller --> client --: response (success or error)
end
deactivate router
deactivate server

newpage View Massage Shops (GET)
client -> server ++: req.get('/api/v1/shops')
server -> router ++: app.use('/api/v1/shops', shops)
router -> controller ++: getShops()
note over client, router
    Public endpoint: authentication is not required.
end note
note over model
    Massage is the local alias of the MassageShop model.
end note
controller -> model ++: Massage.find().sort({name: 1})
model -> db ++: Find shops ordered by name
db --> model --: shops (may be empty)
model --> controller --: shops (may be empty)
controller -> controller: Prepare shop list with name, address, tel,\nopeningTime, and closingTime
controller --> client --: response (success or error)
deactivate router
deactivate server

newpage Make a Reservation (POST)
client -> server ++: req.post('/api/v1/reservations')
server -> router ++: app.use('/api/v1/reservations', reservations)
router -> auth ++: protect(req, res, next)
auth -> auth: Authenticate Bearer token and load req.user
alt Authentication succeeds
    auth --> router: next()
else Missing, invalid, expired, or revoked token
    auth --> client: 401 Unauthorized
end
deactivate auth
opt Authentication succeeds
router -> controller ++: createReservation()
controller -> controller: Validate shopId, reservationDate, startTime;\nrequire a future booking time
opt Input and booking time are valid
controller -> model ++: MassageShop.findById(shopId); SpecialClosingDate.exists({shopId, date})
model -> db ++: Find shop and special closing date
db --> model --: shop and closing-date information
model --> controller --: shop and closing-date information
end
alt Input valid and shop open at selected date/time
    group Transaction: serialize bookings for this user; count and create atomically
controller -> model ++: Reservation.countDocuments({userId: req.user.id, status: 'confirmed'}).session(session)
model -> db ++: Count confirmed reservations for current user
db --> model --: reservationCount
model --> controller --: reservationCount
        alt reservationCount < 3
controller -> model ++: Reservation.create([{userId, shopId, reservationDate, startTime, status: 'confirmed'}], {session})
model -> db ++: Insert confirmed reservation
db --> model --: reservation
model --> controller --: reservation
            ref over controller, model, db, email
                After commit, for user role: notifyReservationAdmins(reservation, user, shop).
                Find admin emails and sendEmail() in background.
                Email failure does not fail reservation.
            end ref
            controller -> controller: Prepare reservation response (201)
        else reservationCount >= 3
            controller -> controller: Prepare reservation-limit error (400)
        end
    end
else Invalid input, missing shop, or shop closed
    controller -> controller: Prepare booking error and reason
end
controller --> client --: response (success or error)
end
deactivate router
deactivate server

