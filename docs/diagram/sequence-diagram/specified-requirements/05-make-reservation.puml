@startuml
header Massage Reservation Sequence Diagram
footer Page %page% of %lastpage%
skinparam maxMessageSize 320
title "Make a Reservation (POST)"

participant "Client" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:reservations" as router
participant "<<controllers>>\n:reservation" as controller
participant "<<model>>\n:Reservation" as model
database "<<MongoDB>>\n:reservations" as db
participant "<<model>>\n:MassageShop / SpecialClosingDate" as shopModels
database "<<MongoDB>>\n:massageshops / specialclosingdates" as shopDb

client -> server ++: req.post('/api/v1/reservations')
server -> router ++: app.use('/api/v1/reservations', reservations)
ref over client, router
    Precondition: valid Bearer token; protect() has authenticated req.user.
end ref
router -> controller ++: createReservation()
controller -> controller: Validate shopId, reservationDate, startTime;\nrequire a future booking time
opt Input and booking time are valid
controller -> shopModels ++: MassageShop.findById(shopId); SpecialClosingDate.exists({shopId, date})
shopModels -> shopDb ++: Find shop and special closing date
shopDb --> shopModels --: shop and closing-date information
shopModels --> controller --: shop and closing-date information
end
alt Input valid and shop open at selected date/time
    group Transaction: serialize bookings for this user; count and create atomically
controller -> model ++: Reservation.countDocuments({userId: req.user.id, status: 'confirmed'}).session(session)
model -> db ++: Count confirmed reservations for current user
db --> model --: reservationCount
model --> controller --: reservationCount
        alt reservationCount < 3
controller -> model ++: Reservation.create([{userId, shopId, reservationDate, startTime, status: 'confirmed'}], {session})
model -> db ++: Insert confirmed reservation
db --> model --: reservation
model --> controller --: reservation
            controller -> controller: Prepare reservation response (201)
        else reservationCount >= 3
            controller -> controller: Prepare reservation-limit error (400)
        end
    end
else Invalid input, missing shop, or shop closed
    controller -> controller: Prepare booking error and reason
end
controller --> client --: response (success or error)
deactivate router
deactivate server

@enduml
