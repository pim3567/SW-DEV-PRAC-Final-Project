@startuml
header Massage Reservation Sequence Diagram
footer Page %page% of %lastpage%
skinparam maxMessageSize 320
title "Edit Own Reservation (PUT)"

participant "Client" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:reservations" as router
participant "<<controllers>>\n:reservation" as controller
participant "<<model>>\n:Reservation" as model
database "<<MongoDB>>\n:reservations" as db
participant "<<model>>\n:MassageShop / SpecialClosingDate" as shopModels
database "<<MongoDB>>\n:massageshops / specialclosingdates" as shopDb

client -> server ++: req.put('/api/v1/reservations/{id}')
server -> router ++: app.use('/api/v1/reservations', reservations)
ref over client, router
    Precondition: valid Bearer token; protect() has authenticated req.user.
end ref
router -> controller ++: updateReservation()
controller -> model ++: Reservation.findById(req.params.id)
model -> db ++: Find reservation by ID
db --> model --: reservation or null
model --> controller --: reservation or null
controller -> controller: Check ownership, confirmed status, and updated fields
opt Reservation exists, access allowed, and initial checks pass
controller -> shopModels ++: MassageShop.findById(shopId); SpecialClosingDate.exists({shopId, date})
shopModels -> shopDb ++: Read selected shop and special closing date
shopDb --> shopModels --: shop and closing-date information
shopModels --> controller --: shop and closing-date information
    controller -> controller: Require future booking time within operating hours;\nreject special closing date
end
alt All validation and access checks pass
controller -> model ++: Reservation.findOneAndUpdate(filter, {$set: updates}, options)
model -> db ++: Update confirmed reservation belonging to current user
db --> model --: updated reservation or conflict
model --> controller --: updated reservation or conflict
else Invalid ID, missing reservation, denied access, or invalid update
    controller -> controller: Prepare update error and reason
end
controller --> client --: response (success or error)
deactivate router
deactivate server

@enduml
