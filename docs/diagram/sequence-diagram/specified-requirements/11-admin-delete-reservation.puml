@startuml
header Massage Reservation Sequence Diagram
footer Page %page% of %lastpage%
skinparam maxMessageSize 320
title "Admin Deletes Any Reservation (DELETE)"

participant "Client" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:reservations" as router
participant "<<controllers>>\n:reservation" as controller
participant "<<model>>\n:Reservation" as model
database "<<MongoDB>>\n:reservations" as db

client -> server ++: req.delete('/api/v1/reservations/{id}')
server -> router ++: app.use('/api/v1/reservations', reservations)
ref over client, router
    Precondition: valid Bearer token; protect() has authenticated req.user.
end ref
router -> controller ++: deleteReservation()
note over client
    Precondition: requester is an admin.
end note
controller -> model ++: Reservation.findById(req.params.id)
model -> db ++: Find reservation by ID
db --> model --: reservation or null
model --> controller --: reservation or null
controller -> controller: Check admin role (any owner allowed)
alt Valid ID, reservation exists, and access allowed
controller -> model ++: Reservation.findOneAndDelete(filter)
model -> db ++: Delete reservation regardless of owner
db --> model --: deleted reservation or not found
model --> controller --: deleted reservation or not found
else Invalid ID, missing reservation, or denied access
    controller -> controller: Prepare deletion error and reason
end
controller --> client --: response (success or error)
deactivate router
deactivate server

@enduml
