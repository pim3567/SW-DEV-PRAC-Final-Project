{
  "info": {
    "name": "MassageReservation - Presentation Demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Presentation steps 1-12 with registration validation, booking conditions, user CRUD, logout invalidation, and admin CRUD of another user booking. Requires an existing admin and a shop open on the generated date (seven days ahead). Creates a new demo user each run; successful runs delete their three demo bookings. Run on a demo database. Password reset, ratings, closing dates and shop management remain in MassageReservation.json."
  },
  "variable": [
    {
      "key": "URL",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin01@gmail.com",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "12345678",
      "type": "string"
    },
    {
      "key": "demoPassword",
      "value": "NewmanDemo123!",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Register a new user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{URL}}/api/v1/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Newman Demo User\",\n  \"tel\": \"0898765432\",\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('demoEmail', 'newman.' + pm.variables.replaceIn('{{$guid}}') + '@example.com');",
              "pm.collectionVariables.set('demoDate', new Date(Date.now() + 7 * 86400000 + 7 * 3600000).toISOString().slice(0, 10));",
              "['demoUserId','demoUserToken','demoAdminToken','demoShopId','demoBookingId','demoAdminBookingId','demoLimitBookingId'].forEach(function (key) { pm.collectionVariables.unset(key); });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response success is true', function () { pm.expect(pm.response.json().success).to.eql(true); });",
              "pm.test('Registration creates a user and returns an ID', function () {",
              "  const b = pm.response.json(); pm.expect(b.role).to.eql('user');",
              "  pm.expect(b._id).to.be.a('string').and.not.empty; pm.collectionVariables.set('demoUserId', b._id);",
              "});"
            ]
          }
        }
      ]
    },
