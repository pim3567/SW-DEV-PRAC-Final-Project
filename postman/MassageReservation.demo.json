    {
      "name": "03 - View shops and select a shop",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{URL}}/api/v1/shops",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response success is true', function () { pm.expect(pm.response.json().success).to.eql(true); });",
              "pm.test('A shop has time for creation and rescheduling', function () {",
              "  const shops = pm.response.json().data; pm.expect(shops).to.be.an('array').and.not.empty;",
              "  const minutes = function (time) { const p = time.split(':').map(Number); return p[0] * 60 + p[1]; };",
              "  const shop = shops.find(function (s) { return minutes(s.closingTime) - minutes(s.openingTime) >= 2; });",
              "  pm.expect(shop, 'Need an existing shop open for at least two minutes').to.be.an('object');",
              "  pm.collectionVariables.set('demoShopId', shop._id); pm.collectionVariables.set('demoStartTime', shop.openingTime);",
              "  pm.collectionVariables.set('demoOutsideTime', shop.closingTime);",
              "  const next = minutes(shop.openingTime) + 1; pm.collectionVariables.set('demoUpdatedTime', String(Math.floor(next / 60)).padStart(2, '0') + ':' + String(next % 60).padStart(2, '0'));",
              "});"
            ]
          }
        }
      ]
    },
